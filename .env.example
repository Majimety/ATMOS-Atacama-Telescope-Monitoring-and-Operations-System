# ATMOS Environment Variables
# คัดลอกไฟล์นี้เป็น .env และกำหนดค่าที่เหมาะสม
# สร้าง secret key: openssl rand -hex 32

# ── Server ────────────────────────────────────────────────────

# JWT secret key — ต้องเปลี่ยนก่อนนำไปใช้งานในสภาพแวดล้อมจริง
ATMOS_SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32

# ระยะเวลาหมดอายุของ access token (หน่วย: นาที, ค่าเริ่มต้น: 60)
ATMOS_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Domain & TLS (จำเป็นสำหรับ Docker production stack) ──────

# โดเมนสาธารณะ — ใช้โดย Traefik สำหรับการกำหนดเส้นทางและ TLS
DOMAIN=atmos.example.com

# อีเมลสำหรับรับการแจ้งเตือนจาก Let's Encrypt
ACME_EMAIL=admin@example.com

# รหัสผ่านสำหรับ Traefik dashboard ในรูปแบบ htpasswd
# สร้างด้วยคำสั่ง: htpasswd -nb admin yourpassword
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$10$$changeThisHash

# ── InfluxDB ──────────────────────────────────────────────────
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=atmos-dev-token-change-in-production
INFLUX_ORG=atmos

# bucket หลักสำหรับข้อมูล telemetry รายจาน และข้อมูลสรุปของ array
# ต้องตรงกับค่าเริ่มต้นของ INFLUX_BUCKET ใน influx_writer.py (atmos_telemetry)
INFLUX_BUCKET=atmos_telemetry
INFLUX_BUCKET_ATMOSPHERE=atmos_atmosphere
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-this-influx-password

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=change-this-redis-password

# ── Weather API ───────────────────────────────────────────────
# Open-Meteo ให้บริการโดยไม่มีค่าใช้จ่ายและไม่ต้องใช้ API key
# หากเว้นว่างไว้ ระบบจะใช้ข้อมูลจำลองแทน (simulation fallback)
# OPEN_METEO_OVERRIDE_URL=

# ── CORS ──────────────────────────────────────────────────────
# รายการ origin ของ frontend ที่อนุญาต คั่นด้วยเครื่องหมายจุลภาค
# สำหรับสภาพแวดล้อมจริง ให้ระบุโดเมนที่ใช้งาน เช่น https://atmos.example.com
ATMOS_CORS_ORIGINS=http://localhost:5173,http://localhost:80

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO