# ATMOS Environment Variables
# Copy this file to .env and set appropriate values
# Generate secret key: openssl rand -hex 32

# ── Server ────────────────────────────────────────────────────

# JWT secret key — must be changed before deploying to production
ATMOS_SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32

# Access token expiry duration (minutes, default: 60)
ATMOS_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Domain & TLS (required for Docker production stack) ───────

# Public domain — used by Traefik for routing and TLS termination
# For local development use: localhost
# For production use your actual domain e.g.: atmos.example.com
DOMAIN=atmos.example.com

# Email address for Let's Encrypt notifications
ACME_EMAIL=admin@example.com

# Traefik dashboard password in htpasswd format
# Generate with: htpasswd -nb admin yourpassword
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$10$$changeThisHash

# ── Frontend ──────────────────────────────────────────────────

# Backend API and WebSocket URLs (used at Vite build time)
# For local development:  VITE_API_URL=http://localhost:8000
#                         VITE_WS_URL=ws://localhost:8000
# For production:         VITE_API_URL=https://atmos.example.com
#                         VITE_WS_URL=wss://atmos.example.com
VITE_API_URL=https://atmos.example.com
VITE_WS_URL=wss://atmos.example.com

# ── InfluxDB ──────────────────────────────────────────────────
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=atmos-dev-token-change-in-production
INFLUX_ORG=atmos

# Primary bucket for per-dish telemetry and array summary data
# Must match the default INFLUX_BUCKET in influx_writer.py (atmos_telemetry)
INFLUX_BUCKET=atmos_telemetry
INFLUX_BUCKET_ATMOSPHERE=atmos_atmosphere
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-this-influx-password

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=change-this-redis-password

# ── Weather API ───────────────────────────────────────────────
# Open-Meteo is free and requires no API key
# If left unset, the system will fall back to simulated atmosphere data
# OPEN_METEO_OVERRIDE_URL=

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# For local development: http://localhost:5173,http://localhost:8080
# For production:        https://atmos.example.com
ATMOS_CORS_ORIGINS=https://atmos.example.com

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO